{
  "uid": "mtca-overview",
  "title": "MicroTCA crates - summary",
  "tags": [
    "mtca",
    "ipmi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "crate",
        "label": "Crate",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"mtca\"}, crate)",
          "refId": "crate"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "amc",
        "label": "AMC slot",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(mch_sensor_value{crate=~\"$crate\", amc!=\"0\"}, amc)",
          "refId": "amc"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "sort": 3,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Sweep OK - all crates",
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 18,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(mch_sweep_success * on(crate) group_left() up{job=~\"mtca.*\"}) or (up{job=~\"mtca.*\"} * 0)",
          "instant": true,
          "legendFormat": "{{crate}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "center",
        "text": {
          "valueSize": 28,
          "titleSize": 12
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "text",
      "id": 20,
      "title": "",
      "transparent": false,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "**MCH access** &nbsp; [\u23f8 pause](http://127.0.0.1:9390/pause) \u00b7 [\u25b6 resume](http://127.0.0.1:9390/resume)\n\n<sub>pause frees the session table for firmware tooling; resume restores data on the next sweep</sub>"
      }
    },
    {
      "type": "timeseries",
      "title": "Current (A) - PM total",
      "id": 4,
      "gridPos": {
        "h": 17,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mch_sensor_value{crate=~\"$crate\", kind=\"current\", orig=\"Current(Sum)\"}",
          "legendFormat": "{{display}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max",
            "mean",
            "min"
          ],
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "decimals": 2,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Current (A) - PM channels",
      "gridPos": {
        "h": 17,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mch_sensor_value{crate=~\"$crate\", kind=\"current\", orig=~\"Ch[0-9]+ Current|Base Current\"}",
          "legendFormat": "{{display}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max",
            "mean",
            "min"
          ],
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "decimals": 2,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Temperatures (C)",
      "id": 2,
      "gridPos": {
        "h": 17,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mch_sensor_value{crate=~\"$crate\", kind=\"temperature\", amc=~\"$amc\"}",
          "legendFormat": "{{display}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max",
            "mean",
            "min"
          ],
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 65
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Cooling unit fans (RPM)",
      "id": 3,
      "gridPos": {
        "h": 17,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mch_sensor_value{crate=~\"$crate\", kind=\"fan\"}",
          "legendFormat": "{{display}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max",
            "mean",
            "min"
          ],
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        }
      }
    }
  ],
  "links": [
    {
      "title": "AMC details",
      "url": "/d/mtca-amc",
      "type": "link",
      "icon": "external link",
      "keepTime": true,
      "targetBlank": false
    }
  ]
}