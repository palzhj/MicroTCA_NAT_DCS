__pycache__/
*.py[cod]

# runtime logs (the systemd unit logs to the journal)
var/

# scratch
.scratch/

# screenshots are deliverables, but generated ones may be re-rendered
# docs/screenshots/*.png

# the real crate table holds site IPs; only the example is tracked
crates/crate-aliases.json
crates/hosts.snippet

# SDR dumps are per-site caches, regenerated by scan_mch.py
*.sdr

# local credentials (compose reads deploy/.env)
deploy/.env
